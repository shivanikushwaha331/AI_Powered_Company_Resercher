# AI Company Research Assistant - Environment Configuration
# Copy this file to .env and populate key values.

# Application Configuration
APP_NAME="AI Company Research Assistant"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# Mock Mode (Set to false when live API keys are provided)
MOCK_MODE=true

# OpenRouter LLM API Key (https://openrouter.ai)
OPENROUTER_API_KEY=""

# Serper.dev Google Search API Key (https://serper.dev)
SERPER_API_KEY=""

# Optional API Keys
GEMINI_API_KEY=""
OPENAI_API_KEY=""
TAVILY_API_KEY=""

# Optional Discord Bot Credentials
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""
